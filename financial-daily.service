[Unit]
Description=Financial Daily Report System
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/financial-daily-system
Environment="PATH=/opt/financial-daily-system/venv/bin"
ExecStart=/opt/financial-daily-system/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 9998
Restart=always
RestartSec=10
StandardOutput=append:/opt/financial-daily-system/logs/service.log
StandardError=append:/opt/financial-daily-system/logs/service_error.log

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/financial-daily-system/data /opt/financial-daily-system/logs

[Install]
WantedBy=multi-user.target
