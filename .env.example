# 应用配置
APP_NAME=金融日报系统
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DATABASE_URL=sqlite:///./data/financial_daily.db

# RSSHub配置
RSSHUB_BASE_URL=http://101.42.187.241:1200

# AI模型配置
# 支持的提供商: deepseek, openai, azure, anthropic, custom
AI_PROVIDER=deepseek
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# DeepSeek示例配置
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# OpenAI示例配置
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4

# 自定义API示例配置
# AI_PROVIDER=custom
# AI_API_KEY=your-key
# AI_BASE_URL=https://your-api.com/v1
# AI_MODEL=your-model

# 邮件配置
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-email@163.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM_NAME=金融日报系统

# 任务调度配置
DAILY_REPORT_TIME=08:00
TIMEZONE=Asia/Shanghai

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
